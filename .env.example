# Template for local configuration. Copy, do not rename:
#   cp .env.example .env
# .env is gitignored; this file is tracked and must never hold a real value.

# Public portfolio demo (M1-11). Set to 1 on the deployed host so the desk
# serves only the synthetic fixture fixtures/macro/public-demo.2026-07-29.json
# (illustrative scenario — not live/historical market data). Leave unset
# locally so npm run daily / live mode keep working. Never put a Tiingo token
# on the public host for this milestone.
GAMMADESK_PUBLIC_DEMO=

# Tiingo API token, used for the ETF proxies (GLD, CPER, USO, UUP) and BTC.
# Free tier at https://www.tiingo.com/account/api/token
# Local / daily pipeline only — do not set on the public demo deployment.
TIINGO_TOKEN=

# Which interpreter renders the DominantDriver narrative: template | llm
# "template" is deterministic and needs no key; it is also the fallback
# whenever an LLM response fails contract validation.
MACRO_INTERPRETER=template

# Only needed when MACRO_INTERPRETER=llm
LLM_API_KEY=

# M2-3C evidence-grounded AI briefs (OpenAI Responses API).
# Local enhance only — never set on the public demo host.
# ChatGPT/Cursor subscription credits are NOT API credits.
OPENAI_API_KEY=
# Optional override; config default is gpt-5.6-luna when unset.
CATALYST_LLM_MODEL=

# M2-4A event market-context snapshots (Alpaca Historical Stock Bars).
# Local fetch only — never set on the public demo host.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Optional feed override; config default is sip when unset.
CATALYST_MARKET_FEED=

# M2-4C evidence-grounded AI market-reaction narratives (OpenAI Responses API).
# Local enhance only — never set on the public demo host.
# Shares OPENAI_API_KEY with M2-3C. Optional model override:
CATALYST_REACTION_LLM_MODEL=

# M2-5A-Lite integration smoke (manual only).
#   npm run catalyst:integration:smoke -- --dry-run
#   npm run catalyst:integration:smoke -- --live --max-events 2
# Uses OPENAI_API_KEY + CATALYST_LLM_MODEL + CATALYST_REACTION_LLM_MODEL above.
# Alpaca live smoke stays awaiting_credentials until APCA_* are available.
# Never set these keys on the public demo host. CI/tests never auto-call providers.
