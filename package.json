{
  "name": "gammadesk",
  "version": "0.0.0",
  "private": true,
  "description": "AI Market Structure Copilot — Driver, Catalyst, Structure, Confirmation, Updated View",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:tiingo": "node --env-file=.env scripts/verify-tiingo.mjs",
    "ingest": "tsx --env-file=.env scripts/ingest-macro.ts",
    "interpret": "tsx --env-file=.env scripts/interpret-macro.ts",
    "daily": "tsx --env-file=.env scripts/run-daily.ts",
    "calibrate": "tsx --env-file=.env scripts/calibrate-report.ts",
    "catalyst:fetch": "tsx scripts/fetch-catalyst-calendar.ts",
    "catalyst:results:fetch": "tsx scripts/fetch-catalyst-results.ts",
    "catalyst:documents:fetch": "tsx scripts/fetch-catalyst-documents.ts",
    "catalyst:briefs:build": "tsx scripts/build-catalyst-briefs.ts",
    "catalyst:briefs:enhance": "tsx --env-file=.env scripts/enhance-catalyst-briefs.ts",
    "catalyst:market-context:fetch": "tsx --env-file=.env scripts/fetch-catalyst-market-context.ts",
    "catalyst:market-reactions:build": "tsx scripts/build-catalyst-market-reactions.ts",
    "catalyst:market-reactions:enhance": "tsx --env-file=.env scripts/enhance-catalyst-market-reactions.ts",
    "catalyst:integration:smoke": "tsx --env-file=.env scripts/catalyst-integration-smoke.ts",
    "catalyst:update": "tsx --env-file=.env scripts/update-catalyst.ts",
    "gamma:fetch": "tsx --env-file=.env scripts/fetch-gamma-marketdata.ts",
    "smoke:demo": "vitest run tests/deploy-smoke.test.ts tests/public-demo.test.ts",
    "smoke:demo:prod": "GAMMADESK_PUBLIC_DEMO=1 next build && vitest run --config vitest.prod.config.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "next": "16.2.12",
    "node-html-parser": "^9.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsx": "4.20.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x"
  }
}
